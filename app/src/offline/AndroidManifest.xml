<?xml version="1.0" encoding="utf-8"?>
<!--
  Strict offline flavor: strip network permissions from the final merged
  manifest, regardless of which library merged them in. `tools:node="remove"`
  on the exact permission name removes it even if a dependency added it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
</manifest>
